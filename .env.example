# Copy to .env (never commit it). Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
# Your team's key from https://arena.tacto.ai/apply (one per team; never commit it)
ARENA_API_KEY=
# The data package (the repo copy; `uv run arena data --out negotiation-agent/negotiation-arena-kit/data` adds the Sunday release)
ARENA_DATA=negotiation-agent/negotiation-arena-kit/data

# Claude, your own key. The reader and writer run on this model; keep the effort low for the 60 s clock.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
